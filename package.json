{
  "name": "bansou",
  "displayName": "BANSOU",
  "description": "BANSOU: git diff comprehension quiz and proof tokens.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.svg",
  "activationEvents": [
    "onView:bansou.sidebar",
    "onCommand:bansou.openSidebar"
  ],
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "terminalDataWriteEvent"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bansou.openSidebar",
        "title": "BANSOU: Open Sidebar"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bansou",
          "title": "BANSOU",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "bansou": [
        {
          "id": "bansou.sidebar",
          "name": "BANSOU",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "BANSOU",
      "properties": {
        "understandingQuiz.model": {
          "type": "string",
          "default": "gpt-5-mini",
          "description": "OpenAI model name for quiz generation."
        },
        "understandingQuiz.openAIMode": {
          "type": "string",
          "enum": ["localOnly", "useOpenAI"],
          "default": "localOnly",
          "description": "Generate summary/PR draft locally or via OpenAI."
        },
        "understandingQuiz.excludeGlobs": {
          "type": "array",
          "default": [
            "package-lock.json",
            "package.json",
            "pnpm-lock.yaml",
            "yarn.lock",
            "**/*.min.js",
            "**/*.map",
            "dist/**",
            "build/**",
            "**/*.png",
            "**/*.jpg",
            "**/*.jpeg",
            "**/*.gif",
            "**/*.pdf"
          ],
          "items": {
            "type": "string"
          },
          "description": "Globs to exclude from quiz by default."
        },
        "understandingQuiz.questionCount": {
          "type": ["string", "number"],
          "default": "auto",
          "description": "Number of questions or 'auto' to derive from diff size."
        },
        "understandingQuiz.passScore": {
          "type": "number",
          "default": 80,
          "description": "Score threshold (0-100) required to pass."
        },
        "understandingQuiz.tokenSecretSource": {
          "type": "string",
          "enum": ["envOnly"],
          "default": "envOnly",
          "description": "Token signing secret source."
        },
        "understandingQuiz.githubIntegration": {
          "type": "string",
          "enum": ["off", "copyTemplate", "postComment"],
          "default": "copyTemplate",
          "description": "PR integration mode."
        },
        "understandingQuiz.terminalErrorQuiz": {
          "type": "boolean",
          "default": true,
          "description": "Detect terminal errors and offer a comprehension quiz."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
